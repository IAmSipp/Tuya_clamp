# Tuya Cloud credentials from one Tuya Cloud project.
# Do not commit real .env values.
TUYA_ACCESS_ID=
TUYA_ACCESS_KEY=

# Tuya message queue settings.
# Use event for production projects, or event-test for Tuya test projects.
TUYA_MQ_ENV=event

# Set this explicitly to the Pulsar endpoint for the enabled Tuya data center.
# Singapore: pulsar+ssl://mqe-sg.iotbing.com:7285/
# China:     pulsar+ssl://mqe.tuyacn.com:7285/
# United States: pulsar+ssl://mqe.tuyaus.com:7285/
# Europe:    pulsar+ssl://mqe.tuyaeu.com:7285/
# India:     pulsar+ssl://mqe.tuyain.com:7285/
TUYA_PULSAR_SERVER_URL=

# Optional metadata tags for InfluxDB/Grafana.
TUYA_DEVICE_ID=
TUYA_DEVICE_NAME=
TUYA_DEVICE_LOCATION=
TUYA_LOG_RAW_EVENTS=false
TUYA_ENABLE_SNAPSHOT=false
TUYA_SNAPSHOT_TTL_SECONDS=300
LOG_LEVEL=INFO

# InfluxDB 2.x settings.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET_CLAMP=tuya_test_bucket
